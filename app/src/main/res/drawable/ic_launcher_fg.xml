<?xml version="1.0" encoding="utf-8"?>
<!-- 第五版前景：晨曦底上一块悬浮的曜石玻璃卡，卡上琥珀渐变等号和一枚奶白光点。
     构图 = "一块正在得出结果的屏"，与 APP 内曜石底、琥珀等号键同一套语言 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 柔和落影：三层错位叠出渐隐（贴卡最深，向下渐淡） -->
    <path
        android:pathData="M44,32.4h20a14,14 0 0 1 14,14v20a14,14 0 0 1 -14,14h-20a14,14 0 0 1 -14,-14v-20a14,14 0 0 1 14,-14z"
        android:fillColor="#1EB4650A" />
    <path
        android:pathData="M44,33.6h20a14,14 0 0 1 14,14v20a14,14 0 0 1 -14,14h-20a14,14 0 0 1 -14,-14v-20a14,14 0 0 1 14,-14z"
        android:fillColor="#14B4650A" />
    <path
        android:pathData="M44,34.8h20a14,14 0 0 1 14,14v20a14,14 0 0 1 -14,14h-20a14,14 0 0 1 -14,-14v-20a14,14 0 0 1 14,-14z"
        android:fillColor="#0AB4650A" />

    <!-- 曜石玻璃卡本体，垂直渐变，顶部微亮 -->
    <path android:pathData="M44,31h20a14,14 0 0 1 14,14v20a14,14 0 0 1 -14,14h-20a14,14 0 0 1 -14,-14v-20a14,14 0 0 1 14,-14z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="31"
                android:endX="54"
                android:endY="79"
                android:startColor="#2E2517"
                android:endColor="#171208" />
        </aapt:attr>
    </path>

    <!-- 卡的玻璃上沿：细描边让边角有一线暖光 -->
    <path
        android:pathData="M44,32.1h20a12.9,12.9 0 0 1 12.9,12.9v20a12.9,12.9 0 0 1 -12.9,12.9h-20a12.9,12.9 0 0 1 -12.9,-12.9v-20a12.9,12.9 0 0 1 12.9,-12.9z"
        android:strokeColor="#4DFFD696"
        android:strokeWidth="1.1"
        android:fillColor="#00000000" />

    <!-- 琥珀渐变等号，两道圆头胶囊（x 41~67，上条 y 45.4~51，下条 y 57~62.6） -->
    <path android:pathData="M43.8,45.4h20.4a2.8,2.8 0 0 1 0,5.6h-20.4a2.8,2.8 0 0 1 0,-5.6z M43.8,57h20.4a2.8,2.8 0 0 1 0,5.6h-20.4a2.8,2.8 0 0 1 0,-5.6z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="41"
                android:startY="45.4"
                android:endX="67"
                android:endY="62.6"
                android:startColor="#FFCA64"
                android:endColor="#EC8D12" />
        </aapt:attr>
    </path>

    <!-- 等号上沿高光，玻璃表面 -->
    <path
        android:pathData="M42.4,46.4h20.2a0.7,0.7 0 0 1 0,1.4h-20.2a0.7,0.7 0 0 1 0,-1.4z"
        android:fillColor="#52FFFFFF" />
    <path
        android:pathData="M42.4,58h20.2a0.7,0.7 0 0 1 0,1.4h-20.2a0.7,0.7 0 0 1 0,-1.4z"
        android:fillColor="#40FFFFFF" />

    <!-- 右上奶白光点：一枚还没落下的算珠，也是呼吸灯 -->
    <path
        android:fillColor="#FFF2DC"
        android:pathData="M69,37.9a2.6,2.6 0 0 1 0,5.2a2.6,2.6 0 0 1 0,-5.2z" />

</vector>
