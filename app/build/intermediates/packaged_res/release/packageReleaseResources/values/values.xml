<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="cinnabar">#B4442C</color>
    <color name="error_text">#B3402B</color>
    <color name="history_tint">#6F6650</color>
    <color name="ink">#2A241A</color>
    <color name="ink_soft">#9A907C</color>
    <color name="key_bg">#FFFFFF</color>
    <color name="key_eq_text">#FFF6EE</color>
    <color name="key_fn_bg">#EFE7D3</color>
    <color name="key_fn_text">#6F6650</color>
    <color name="key_op_bg">#F5E4D2</color>
    <color name="key_op_text">#B4442C</color>
    <color name="key_stroke">#E8DFC9</color>
    <color name="paper">#F6F1E6</color>
    <color name="sheet_bg">#FBF7EE</color>
    <dimen name="key_gap">8dp</dimen>
    <dimen name="key_height">68dp</dimen>
    <dimen name="key_radius">26dp</dimen>
    <string name="app_name">妙算</string>
    <string name="backspace">退格</string>
    <string name="copied">已复制结果</string>
    <string name="history">历史记录</string>
    <string name="history_clear">清空</string>
    <string name="history_empty">还没有算过什么</string>
    <string name="key_0">0</string>
    <string name="key_1">1</string>
    <string name="key_2">2</string>
    <string name="key_3">3</string>
    <string name="key_4">4</string>
    <string name="key_5">5</string>
    <string name="key_6">6</string>
    <string name="key_7">7</string>
    <string name="key_8">8</string>
    <string name="key_9">9</string>
    <string name="key_clear">C</string>
    <string name="key_divide">÷</string>
    <string name="key_dot">.</string>
    <string name="key_equals">=</string>
    <string name="key_minus">−</string>
    <string name="key_multiply">×</string>
    <string name="key_percent">%</string>
    <string name="key_plus">+</string>
    <string name="key_toggle_sign">±</string>
    <string name="toggle_theme">切换深浅色</string>
    <string name="zero">0</string>
    <style name="Key">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/key_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">@dimen/key_gap</item>
        <item name="android:background">@drawable/key_bg_digit</item>
        <item name="android:textSize">25sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Key.Eq">
        <item name="android:background">@drawable/key_bg_eq</item>
        <item name="android:textColor">@color/key_eq_text</item>
        <item name="android:textSize">27sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Key.Fn">
        <item name="android:background">@drawable/key_bg_fn</item>
        <item name="android:textColor">@color/key_fn_text</item>
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:padding">0dp</item>
    </style>
    <style name="Key.Op">
        <item name="android:background">@drawable/key_bg_op</item>
        <item name="android:textColor">@color/key_op_text</item>
        <item name="android:textSize">27sp</item>
    </style>
    <style name="KeyRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/key_gap</item>
        <item name="android:layout_marginHorizontal">@dimen/key_gap</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="Theme.Qingsuan" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorSurface">@color/sheet_bg</item>
        
        <item name="colorSurfaceContainerLow">@color/sheet_bg</item>
        <item name="colorSurfaceContainerHigh">@color/sheet_bg</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Qingsuan.BottomSheet</item>
    </style>
    <style name="ThemeOverlay.Qingsuan.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurfaceContainerLow">@color/sheet_bg</item>
        <item name="colorSurfaceContainerHigh">@color/sheet_bg</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
    </style>
</resources>