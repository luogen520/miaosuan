<?xml version="1.0" encoding="utf-8"?>
<!-- 一颗穿在杆上的大算珠，琥珀的，跟界面上的等号键同一个颜色 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 穿珠的杆 -->
    <path
        android:pathData="M22,54 L86,54"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.3"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 珠子落下的影子 -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.22"
        android:pathData="M38,73 a16,3.4 0 1,0 32,0 a16,3.4 0 1,0 -32,0 z" />

    <!-- 大算珠，琥珀渐变 -->
    <path android:pathData="M35,54 a19,15.5 0 1,0 38,0 a19,15.5 0 1,0 -38,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="35" android:startY="38.5"
                android:endX="73" android:endY="69.5"
                android:startColor="#FFC969"
                android:endColor="#F08C1F" />
        </aapt:attr>
    </path>

    <!-- 珠上两笔高光 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.6"
        android:pathData="M42.5,46.5 a5.5,3.5 0 1,0 11,0 a5.5,3.5 0 1,0 -11,0 z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.35"
        android:pathData="M40.5,55 a2.2,1.6 0 1,0 4.4,0 a2.2,1.6 0 1,0 -4.4,0 z" />

</vector>
